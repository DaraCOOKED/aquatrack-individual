# Editors and operating-system files
**/.idea/
**/.vscode/
**/.DS_Store

# Environment files and credentials (examples stay tracked)
**/.env
**/.env.*
!**/.env.example
**/auth.json
**/credentials.json
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*

# Dependencies and generated frontend output
**/node_modules/
**/vendor/
frontend/dist/
frontend/.vite/

# Laravel runtime and generated caches
backend/bootstrap/cache/*.php
backend/storage/*.key
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
backend/storage/logs/*
backend/public/storage

# Test and tool output
**/.phpunit.cache/
**/.phpunit.result.cache
*.log

